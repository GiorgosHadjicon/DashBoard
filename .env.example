# Copy to .env and fill in. .env is gitignored.
GARMIN_EMAIL=
GARMIN_PASSWORD=
# iCloud needs an app-specific password: appleid.apple.com → Sign-In and Security
ICLOUD_EMAIL=
ICLOUD_APP_PASSWORD=
# Calendars you only *subscribe* to in Apple Calendar (a URL feed, e.g. a course timetable) don't
# come through iCloud CalDAV above — list them here instead, one "Name=URL" per line.
# ICS_FEEDS=SCSS Timetable=https://example.com/timetable.ics
