# Copy to .env and fill in. .env is gitignored.
GARMIN_EMAIL=
GARMIN_PASSWORD=
# iCloud needs an app-specific password: appleid.apple.com → Sign-In and Security
ICLOUD_EMAIL=
ICLOUD_APP_PASSWORD=
# Gmail needs an app password (requires 2-Step Verification): myaccount.google.com/apppasswords
GMAIL_EMAIL=georgehadjiconstantis@gmail.com
GMAIL_APP_PASSWORD=
# Any Gmail search string; defines what counts as "important"
# Your TCD mail (hadjicog@tcd.ie) is Microsoft 365, which IMAP app passwords can't read, so
# forward it to Gmail with an Outlook rule and this query picks out modules + tech careers mail.
GMAIL_QUERY=newer_than:14d (("Discrete Mathematics" OR "Applied Probability" OR "Information Management" OR "Computer Architecture" OR "Algorithms and Data Structures" OR "Systems Programming") OR ((from:careerservices OR from:"careers service") (tech OR technology OR software OR cyber OR engineering OR "computer science")))
