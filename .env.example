# Copy to .env and fill in. .env is gitignored.
GARMIN_EMAIL=
GARMIN_PASSWORD=
# iCloud needs an app-specific password: appleid.apple.com → Sign-In and Security
ICLOUD_EMAIL=
ICLOUD_APP_PASSWORD=
# Gmail needs an app password (requires 2-Step Verification): myaccount.google.com/apppasswords
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
# Any Gmail search string; defines what counts as "important"
GMAIL_QUERY=is:important is:unread newer_than:14d
