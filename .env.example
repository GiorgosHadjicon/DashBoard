# Copy to .env and fill in. .env is gitignored.
GARMIN_EMAIL=
GARMIN_PASSWORD=
# iCloud needs an app-specific password: appleid.apple.com → Sign-In and Security
ICLOUD_EMAIL=
ICLOUD_APP_PASSWORD=
# Any calendar that's just a feed rather than a CalDAV calendar you own — a course timetable, a
# Google Calendar's private iCal address, an Apple "New Calendar Subscription" — goes here instead,
# as "Name=URL", separated by " | " (or one per line, quoting the whole value).
# Google Calendar: calendar.google.com → Settings → pick the calendar → Integrate calendar →
# "Secret address in iCal format". Treat that URL like a password — don't share it.
# ICS_FEEDS=SCSS Timetable=https://example.com/timetable.ics | Personal=https://calendar.google.com/calendar/ical/you%40gmail.com/private-xxxx/basic.ics

# Which port the server listens on. Optional — defaults to 3000.
# PORT=3000

# Optional: also bind here, so your other devices can reach the dashboard too. Always still reachable
# at localhost on this machine regardless. Use a Tailscale IP (`tailscale ip -4` on this Mac), never
# 0.0.0.0 or your real LAN IP — those open it to your whole Wi-Fi network, and there's still no login.
# HOST=100.x.x.x

# Optional: a free key from football-data.org/client/register — upgrades the Liverpool tab's next
# fixture into a real list of the next several. Without it, that tab still shows the one next game.
# FOOTBALL_DATA_TOKEN=
